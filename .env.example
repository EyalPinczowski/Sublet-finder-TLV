# All of these are optional — omit any of them (or the whole file) to skip
# that feature. The tool always keeps working with whatever's configured.

# Telegram notifications. Omit to just use `scripts/matches.py` manually.
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-chat-id

# Gemini free-tier key (https://aistudio.google.com/apikey) for LLM-based
# listing extraction. Omit to fall back to the regex/keyword parser.
GEMINI_API_KEY=

# Google Sheets sink (see README "Google Sheets"). Put the service-account
# JSON at auth/google_service_account.json and the sheet's id (from its URL)
# here. Leave blank to keep the sink disabled.
GOOGLE_SHEET_ID=

# Live dashboard token (see README "Dashboard"). Any random string. If left
# blank, one is generated into data/dashboard_token.txt on first run.
DASHBOARD_TOKEN=

# Dashboard bind address (see README "Dashboard"). Defaults to 127.0.0.1
# (LAN/local-only) if left blank. Set to your tablet's own LAN IP (e.g.
# 192.168.1.23) to make the dashboard reachable from your phone over WiFi,
# and to make the "Dashboard" button in Telegram alerts actually work —
# NEVER set this to 0.0.0.0 or a public/internet-facing address.
DASHBOARD_HOST=
# Dashboard port. Defaults to 8765 if left blank.
DASHBOARD_PORT=

# Dedicated repo for the published dashboard snapshot (see README
# "Publishing a snapshot"), e.g. git@github.com:you/sublet-finder-tlv-site.git
# NEVER point this at the code repo. Leave blank to skip publishing.
SITE_REPO_URL=
